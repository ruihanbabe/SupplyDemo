# SupplyAgent 环境变量模板
# 用法：cp .env.example .env 后填入真实值。.env 已在 .gitignore 中，不得提交。
# 进程环境变量优先于 .env。

# ---- 数据库（对应 compose.yaml 的 postgres 服务）----
SUPPLYAGENT_PG_HOST=127.0.0.1
SUPPLYAGENT_PG_PORT=5432
SUPPLYAGENT_PG_DB=supplyagent
SUPPLYAGENT_PG_USER=postgres
SUPPLYAGENT_PG_PASSWORD=devonly_change_me

# ---- F34 Python Model Gateway（独立私有 HTTP 进程）----
# 至少 32 字节的随机签名密钥；留空时 gateway-run 拒绝启动。
SUPPLYAGENT_GATEWAY_SIGNING_KEY=
# F35 单组织 Worker 身份须是该组织 maintainer 成员，scope 含 runtimeWorker: true。
# 未配置身份时 runtime-worker 拒绝启动。Replay 只用于本地固定样例测试。
SUPPLYAGENT_WORKER_ORGANIZATION_ID=
SUPPLYAGENT_WORKER_ACTOR_ID=
# 部署标签：1–87 个字母、数字、点、下划线或连字符；进程自动追加实例 UUID。
SUPPLYAGENT_WORKER_OWNER=
SUPPLYAGENT_WORKER_REPLAY=0
SUPPLYAGENT_GATEWAY_URL=http://127.0.0.1:8001/v1
# model_policy.credential_ref 使用大写字母/数字/下划线的 opaque 名称 REF；
# 实际 Provider 凭据仅注入 Python 进程的 SUPPLYAGENT_MODEL_SECRET_REF，不传给 Pi。

# ---- Python 产品 API（F31）----
# 产品 API 使用受限 PostgreSQL 连接；部署身份必须能 SET ROLE supplyagent_api。
SUPPLYAGENT_PRODUCT_DATABASE_URL=postgresql://postgres:devonly_change_me@127.0.0.1:5432/supplyagent
# 仅用于向 Supabase Auth 验证浏览器 bearer token；未配置时 API 安全拒绝业务请求。
SUPPLYAGENT_SUPABASE_AUTH_URL=
SUPPLYAGENT_SUPABASE_PUBLISHABLE_KEY=
# 仅供已获授权的 F31 真实 Auth 验证使用；只填本地 .env，绝不提交。
SUPPLYAGENT_SUPABASE_TEST_EMAIL=
SUPPLYAGENT_SUPABASE_TEST_PASSWORD=

# ---- Redis（对应 compose.yaml 的 redis 服务）----
SUPPLYAGENT_REDIS_PORT=6379

# ---- 当前模型凭据（仅 Python 读取；模型/协议由服务端策略固定）----
SUPPLYAGENT_MODEL_SECRET_ZHIPU=
# 与既有本地配置兼容；上方凭据槽未设置时才使用此项。
SUPPLYAGENT_LLM_ZHIPU_API_KEY=

# ---- 业务入口：迁移/组织策略就绪后按 Contract 启用 ----
SUPPLYAGENT_INTELLIGENCE_ENABLED=1
SUPPLYAGENT_BUSINESS_NODES_ENABLED=0
SUPPLYAGENT_COMMERCIAL_NODES_ENABLED=0
# OpenAI Responses 的兼容入口开关；GLM 使用通用模型入口。
SUPPLYAGENT_RESPONSES_ENABLED=0
SUPPLYAGENT_MODEL_GATEWAY_ENABLED=0

# 供应商/ERP 的真实接口与凭据配置尚未实现；未来按业务逻辑 BL01/BL10 单独接入。

# ---- F48 M1：默认关闭，仅用于显式合成本地验证 ----
# 同时要求 config/product/memory-policy.json enabled=true 和 Context enabled=true。
# 下列地址只允许回环 HTTP /v1；固定 fixture 模型名，不接受真实云端或 SDK 默认模型。
SUPPLYAGENT_MEMORY_STORAGE_PATH=
SUPPLYAGENT_MEMORY_EMBEDDING_URL=
SUPPLYAGENT_MEMORY_SUMMARY_URL=

# F37: disabled by default; fixture only, never real WhatsApp/Feishu.
SUPPLYAGENT_CHANNEL_MODE=off
# Supply from private server-side secret management; do not put a real key in this template.
SUPPLYAGENT_CHANNEL_ENCRYPTION_KEY=
# Optional private SQLite path; default .runtime/channels/fixture.sqlite
# SUPPLYAGENT_CHANNEL_FIXTURE_DB=
