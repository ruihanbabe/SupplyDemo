# SupplyAgent 环境变量模板
# 用法：cp .env.example .env 后填入真实值。.env 已在 .gitignore 中，不得提交。
# 进程环境变量优先于 .env。

# ---- 数据库（对应 compose.yaml 的 postgres 服务）----
SUPPLYAGENT_PG_HOST=127.0.0.1
SUPPLYAGENT_PG_PORT=5432
SUPPLYAGENT_PG_DB=supplyagent
SUPPLYAGENT_PG_USER=postgres
SUPPLYAGENT_PG_PASSWORD=devonly_change_me
SUPPLYAGENT_DATABASE_URL=postgresql+asyncpg://postgres:devonly_change_me@127.0.0.1:5432/supplyagent

# ---- Redis（对应 compose.yaml 的 redis 服务）----
SUPPLYAGENT_REDIS_HOST=127.0.0.1
SUPPLYAGENT_REDIS_PORT=6379
SUPPLYAGENT_REDIS_URL=redis://127.0.0.1:6379/0

# ---- LLM Provider ----
# 分工见 DECISIONS.md D07：
#   模型选择、采样参数、工具清单 → config/agents/*.yaml（进 Git，可 review）
#   凭据与端点                   → 本文件（不进 Git）
# 每个 worker 用哪个模型由它自己的 YAML 决定，不在这里配（D06 要求 Detail 用便宜
# 快速模型、Research 用旗舰模型，全系统共用一个 model 是错的）。

# 全局开关。未显式置 true 时，任何真实模型调用都会被拒绝并报 provider_disabled。
# 真实调用产生费用，必须获得用户明确授权后才打开（见 AGENTS.md 全局硬约束）。
SUPPLYAGENT_LLM_ENABLED=false

# 按 provider 分别配置，便于不同 worker 走不同厂商、用不同的 key。
# 变量名规则：SUPPLYAGENT_LLM_<PROVIDER 大写>_API_KEY / _BASE_URL
SUPPLYAGENT_LLM_ZHIPU_API_KEY=
SUPPLYAGENT_LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 单 provider 场景可只填这组共享值；provider 专属的同名项优先级更高。
SUPPLYAGENT_LLM_API_KEY=
SUPPLYAGENT_LLM_BASE_URL=
SUPPLYAGENT_LLM_TIMEOUT_SECONDS=60

# ---- 供应商 API ----
# 统一前缀 SUPPLYAGENT_SUPPLIER_<厂商>_*：MCP 子进程的环境变量白名单按这一条前缀放行，
# 主进程的其他密钥（数据库、模型）一律不进那个进程。
# 凭据只存本地，不进 Git、不进 Trace、不进 request_digest。
# 哪一家填了 key 就真调哪一家；没填的回退到 fixture 并标 provenance=sample。

# Mouser Search API：https://www.mouser.com/api-search/ 登录后即时获取
SUPPLYAGENT_SUPPLIER_MOUSER_API_KEY=

# element14 / Farnell：https://partner.element14.com/ 注册后获取
SUPPLYAGENT_SUPPLIER_ELEMENT14_API_KEY=
# 站点决定地区与币种，如 uk.farnell.com / www.newark.com / sg.element14.com
SUPPLYAGENT_SUPPLIER_ELEMENT14_STORE=uk.farnell.com

# DigiKey Product Information V4：https://developer.digikey.com/ 建 App 后获取
# 两条都要填；走 OAuth 2-legged 用它们换 token，token 不落盘
SUPPLYAGENT_SUPPLIER_DIGIKEY_CLIENT_ID=
SUPPLYAGENT_SUPPLIER_DIGIKEY_CLIENT_SECRET=
# 用生产端点：sandbox-api.digikey.com 前面挂着 bot 挑战，对普通客户端一律回 403 挑战页
# （实测过）。这里只做只读的产品查询，不触碰任何下单接口；响应头带 x-ratelimit-remaining。
SUPPLYAGENT_SUPPLIER_DIGIKEY_BASE_URL=https://api.digikey.com

SUPPLYAGENT_SUPPLIER_REGION=US
SUPPLYAGENT_SUPPLIER_CURRENCY=USD


# ---- 目标业务系统（ERP）----
# 选型待定，候选与复杂度见 docs/research/procurement-platforms.md
SUPPLYAGENT_ERP_BASE_URL=
SUPPLYAGENT_ERP_API_KEY=
SUPPLYAGENT_ERP_API_SECRET=
